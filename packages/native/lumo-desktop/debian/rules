#!/usr/bin/make -f

export PYTHONDONTWRITEBYTECODE = 1

ICON_SIZES = 16 22 24 32 48 64 128 256
LOGO = data/icons/lumo-logo.svg
ROBOTO = /usr/share/fonts/truetype/roboto/unhinted/RobotoTTF

START_ICON = start-here-kde-symbolic
START_ALIASES = start-here-kde start-here start-here-symbolic

THEME_APPS = generated/icon-theme/scalable/apps

TOOLS = tools
SYMBOLS = data/symbols
APPLETS = launcher:org.lumo.launcher shade:org.lumo.quicksettings clipboard:org.lumo.clipboard
WIDGETS = clock glance weather battery calendar media photo note
LIVE_WALLPAPERS = tower rhythm starfall pastel waves aurora
STILL_WALLPAPERS = dunes bloom contour
COLOURS := $(shell cd $(TOOLS) && python3 -c 'import lumo_design as d; print(" ".join(d.COLOURS))')
EXTRA_COLOURS := $(filter-out lumo,$(COLOURS))

%:
	dh $@

override_dh_auto_build:
	set -e; for size in $(ICON_SIZES); do \
	  install -d generated/hicolor/$${size}x$${size}/apps; \
	  rsvg-convert --width=$$size --height=$$size \
	    --output=generated/hicolor/$${size}x$${size}/apps/lumo-logo.png \
	    $(LOGO); \
	done
	install -d generated/branding generated/skel generated/splash
	rsvg-convert --width=160 --height=160 \
	  --output=generated/branding/lumo-logo.png $(LOGO)
	python3 $(TOOLS)/gen-qm data/calamares/lang/calamares-lumo_ru.ts \
	  generated/branding/lang/calamares-lumo_ru.qm
	python3 $(TOOLS)/gen-installer-icons $(SYMBOLS) generated/branding/images
	python3 $(TOOLS)/gen-installer-style data/calamares/stylesheet.qss.in \
	  generated/branding/stylesheet.qss
	python3 $(TOOLS)/gen-avatar $(LOGO) generated/skel/face.svg
	rsvg-convert --width=256 --height=256 \
	  --output=generated/skel/.face generated/skel/face.svg
	python3 $(TOOLS)/gen-avatars generated/avatars
	rsvg-convert --width=512 --height=512 \
	  --output=generated/avatars/00-lumo.png generated/skel/face.svg
	set -e; for image in generated/avatars/*.svg; do \
	  rsvg-convert --width=512 --height=512 --output=$${image%.svg}.png $$image; \
	  rm $$image; \
	done
	rm generated/skel/face.svg
	rsvg-convert --width=512 --height=512 \
	  --output=generated/splash/lumo.png $(LOGO)
	python3 $(TOOLS)/fetch-symbols --check
	python3 $(TOOLS)/gen-icon-theme $(SYMBOLS) generated/icon-theme
	set -e; for colour in $(EXTRA_COLOURS); do \
	  LUMO_COLOUR=$$colour python3 $(TOOLS)/gen-icon-theme $(SYMBOLS) generated/icon-themes/Lumo-$$colour; \
	done
	python3 $(TOOLS)/gen-cursor-theme generated/lumo_cursors
	sed \
	  -e 's|<g transform=|<style type="text/css" id="current-color-scheme">.ColorScheme-Text{color:#eff0f1;}</style>\n  <g class="ColorScheme-Text" transform=|' \
	  -e 's|fill="#eff0f1"|fill="currentColor"|' \
	  $(LOGO) > $(THEME_APPS)/$(START_ICON).svg
	set -e; for name in $(START_ALIASES); do \
	  cp $(THEME_APPS)/$(START_ICON).svg $(THEME_APPS)/$$name.svg; \
	done
	python3 $(TOOLS)/gen-color-schemes generated/color-schemes
	python3 $(TOOLS)/gen-plasma-theme $(SYMBOLS) generated/desktoptheme/lumo
	set -e; for generation in md1 md2; do \
	  LUMO_GENERATION=$$generation python3 $(TOOLS)/gen-color-schemes generated/color-schemes; \
	  LUMO_GENERATION=$$generation python3 $(TOOLS)/gen-plasma-theme $(SYMBOLS) generated/desktoptheme/lumo-$$generation; \
	done
	set -e; for colour in $(EXTRA_COLOURS); do \
	  for generation in md1 md2 md3; do \
	    suffix=$$(test $$generation = md3 || echo -$$generation); \
	    LUMO_COLOUR=$$colour LUMO_GENERATION=$$generation python3 $(TOOLS)/gen-color-schemes generated/color-schemes; \
	    LUMO_COLOUR=$$colour LUMO_GENERATION=$$generation python3 $(TOOLS)/gen-plasma-theme $(SYMBOLS) \
	      generated/desktoptheme/lumo-$$colour$$suffix generated/desktoptheme/lumo$$suffix; \
	  done; \
	done
	set -e; for colour in $(COLOURS); do \
	  LUMO_COLOUR=$$colour python3 $(TOOLS)/gen-qml-tokens --palette generated/palettes/$$colour.conf; \
	done
	python3 $(TOOLS)/gen-kdeglobals generated/xdg/kdeglobals
	set -e; for entry in $(APPLETS); do \
	  source=$${entry%%:*}; id=$${entry#*:}; \
	  target=generated/plasmoids/$$id; \
	  install -d $$target; \
	  cp -a data/shell/$$source/. $$target/; \
	  cp -a data/shell/m3 $$target/contents/ui/m3; \
	  python3 $(TOOLS)/gen-qml-tokens $$target/contents/ui/m3/M3.qml; \
	done
	install -d generated/wallpapers
	cp -a data/wallpaper/org.lumo.shapes generated/wallpapers/
	python3 $(TOOLS)/gen-wallpaper-assets generated/wallpapers/org.lumo.shapes/contents/ui
	set -e; for theme in $(LIVE_WALLPAPERS) $(STILL_WALLPAPERS); do \
	  cp -a data/wallpaper/org.lumo.$$theme generated/wallpapers/; \
	  python3 $(TOOLS)/gen-wallpaper-assets generated/wallpapers/org.lumo.$$theme/contents/ui $$theme; \
	done
	set -e; for theme in shapes $(LIVE_WALLPAPERS); do \
	  cp data/wallpaper/common/*.qml generated/wallpapers/org.lumo.$$theme/contents/ui/; \
	done
	set -e; for widget in $(WIDGETS); do \
	  target=generated/plasmoids/org.lumo.widget.$$widget; \
	  install -d $$target; \
	  cp -a data/widgets/$$widget/. $$target/; \
	  cp -a data/widgets/common/. $$target/contents/ui/; \
	  cp generated/wallpapers/org.lumo.shapes/contents/ui/materialshapes.js $$target/contents/ui/; \
	  cp -a data/shell/m3 $$target/contents/ui/m3; \
	  python3 $(TOOLS)/gen-qml-tokens $$target/contents/ui/m3/M3.qml; \
	done
	cp data/shell/shade/contents/ui/sources/BatterySource.qml generated/plasmoids/org.lumo.widget.glance/contents/ui/
	cp data/shell/shade/contents/ui/sources/MediaSource.qml data/shell/shade/contents/ui/WavyProgress.qml \
	  generated/plasmoids/org.lumo.widget.media/contents/ui/
	install -d generated/explorer
	cp data/explorer/*.qml data/widgets/common/MaterialShape.qml generated/explorer/
	cp generated/wallpapers/org.lumo.shapes/contents/ui/materialshapes.js generated/explorer/
	set -e; for colour in $(EXTRA_COLOURS); do \
	  LUMO_COLOUR=$$colour python3 $(TOOLS)/gen-wallpaper-assets generated/wallpapers/org.lumo.shapes/contents/ui; \
	  for theme in $(LIVE_WALLPAPERS) $(STILL_WALLPAPERS); do \
	    LUMO_COLOUR=$$colour python3 $(TOOLS)/gen-wallpaper-assets generated/wallpapers/org.lumo.$$theme/contents/ui $$theme; \
	  done; \
	done
	set -e; for colour in $(COLOURS); do \
	  for generation in md1 md2 md3; do \
	    LUMO_COLOUR=$$colour LUMO_GENERATION=$$generation python3 $(TOOLS)/gen-kvantum-theme generated/kvantum; \
	    LUMO_COLOUR=$$colour LUMO_GENERATION=$$generation python3 $(TOOLS)/gen-aurorae-theme generated/aurorae; \
	    LUMO_COLOUR=$$colour LUMO_GENERATION=$$generation python3 $(TOOLS)/gen-gtk-theme generated/gtk-themes; \
	  done; \
	done
	install -d generated/style/org/lumo
	cp -a data/style/org.lumo.desktop generated/style/org/lumo/desktop
	cp -a data/shell/m3 generated/style/org/lumo/desktop/impl
	python3 $(TOOLS)/gen-qml-tokens generated/style/org/lumo/desktop/impl/M3.qml
	cp -a data/shell/m3 generated/style/org/lumo/m3
	sed -i '1i module org.lumo.m3' generated/style/org/lumo/m3/qmldir
	python3 $(TOOLS)/gen-qml-tokens generated/style/org/lumo/m3/M3.qml
	cp -a data/ui generated/style/org/lumo/ui
	python3 $(TOOLS)/gen-translations data/shell/po generated/locale
	set -e; for colour in $(COLOURS); do \
	  LUMO_COLOUR=$$colour python3 $(TOOLS)/gen-terminal-theme generated/terminal; \
	done
	python3 $(TOOLS)/gen-sound-theme generated/sounds
	python3 $(TOOLS)/gen-browser-theme generated/librewolf/theme@lumo.os.xpi generated/librewolf/userChrome.css
	python3 $(TOOLS)/gen-plymouth-theme $(LOGO) $(SYMBOLS) generated/plymouth/lumo
	set -e; for image in generated/plymouth/lumo/*.svg; do \
	  rsvg-convert --output=$${image%.svg}.png $$image; \
	  rm $$image; \
	done
	python3 $(TOOLS)/gen-grub-theme $(LOGO) generated/grub/lumo
	set -e; for image in generated/grub/lumo/*.svg; do \
	  rsvg-convert --output=$${image%.svg}.png $$image; \
	  rm $$image; \
	done
	set -e; for face in Regular:16 Medium:16 Regular:24; do \
	  weight=$${face%%:*}; size=$${face#*:}; \
	  grub-mkfont --size=$$size --name="Roboto $$weight" \
	    --range=0x20-0x7E,0xA0-0x17F,0x400-0x45F,0x2010-0x2027,0x2190-0x2193 \
	    --output=generated/grub/lumo/roboto-$$(echo $$weight | tr A-Z a-z)-$$size.pf2 \
	    $(ROBOTO)/Roboto-$$weight.ttf; \
	done
	install -d generated/sddm
	cp -a data/sddm-theme/lumo generated/sddm/lumo
	python3 $(TOOLS)/gen-greeter-palette $(SYMBOLS) generated/sddm/lumo

override_dh_installsystemd:
	dh_installsystemd -plumo-desktop lumo-drivers.timer lumo-panic-report.service

override_dh_auto_clean:
	rm -rf generated $(TOOLS)/__pycache__
