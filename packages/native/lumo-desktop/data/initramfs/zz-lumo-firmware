#!/bin/sh
set -e

PREREQ=""
prereqs() {
    echo "$PREREQ"
}
case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions
if command -v apply_add_modules >/dev/null 2>&1; then
    apply_add_modules
fi

firmware="${DESTDIR:?}/usr/lib/firmware/nvidia"
[ -d "$firmware" ] || exit 0
for chip in "$firmware"/*; do
    case "${chip##*/}" in
        [0-9]*) ;;
        *) rm -rf "$chip" ;;
    esac
done
