if [ "${1:-}" = check ]; then
    exec /usr/libexec/lumo-android graphics-check
fi
if [ "${1:-}" = wayland ]; then
    exec /usr/libexec/lumo-android use-wayland
fi
exec /usr/libexec/lumo-android refresh
