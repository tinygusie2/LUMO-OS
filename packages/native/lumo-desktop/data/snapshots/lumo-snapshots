#!/bin/sh
set -eu

config=/etc/snapper/configs/root
marker=/var/lib/lumo/snapshots-refresh

booted() {
  sed -n 's/.*lumo\.snapshot=\([0-9][0-9]*\).*/\1/p' /proc/cmdline
}

points() {
  snapper --no-dbus --csvout --separator '|' --no-headers -c root \
    list --columns number,type,date,description 2>/dev/null \
    | awk -F'|' '$1 > 0 && ($2 == "pre" || $2 == "single")' | sort -t'|' -k1,1nr | head -n 10
}

setup() {
  [ "$(findmnt -n -o FSTYPE / || true)" = btrfs ] || exit 0
  [ "$(findmnt -n -o FSTYPE /.snapshots || true)" = btrfs ] || exit 0
  [ ! -e "$config" ] || exit 0
  mkdir -p /etc/snapper/configs
  sed \
    -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
    -e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' \
    -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
    -e 's/^ALLOW_GROUPS=.*/ALLOW_GROUPS="sudo"/' \
    /usr/share/snapper/config-templates/default > "$config"
  chmod 0640 "$config"
  sed -i 's/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS="root"/' /etc/default/snapper
  chmod 0750 /.snapshots
  systemctl enable snapper-cleanup.timer lumo-snapshots.service
  systemctl disable snapper-timeline.timer snapper-boot.timer
}

status() {
  if [ -e "$config" ]; then echo enabled=yes; else echo enabled=no; fi
  echo "booted=$(booted)"
  [ -e "$config" ] || exit 0
  snapper --csvout --separator '|' --no-headers -c root \
    list --columns number,type,date,description 2>/dev/null \
    | awk -F'|' '$1 > 0 && ($2 == "pre" || $2 == "single") {print "point=" $1 "|" $3}' \
    | sort -t= -k2,2nr | head -n 10
}

grub_entries() {
  [ -e "$config" ] || exit 0
  uuid=$(grub-probe --target=fs_uuid /.snapshots)
  . /etc/default/locale 2>/dev/null || true
  case "${LANG:-}" in
    nl*) title=Herstelpunten ;;
    ru*) title="Точки восстановления" ;;
    *) title="Restore points" ;;
  esac
  list=$(points)
  [ -n "$list" ] || exit 0
  echo "submenu '$title' {"
  echo "$list" | while IFS='|' read -r number _ date _; do
    boot=/.snapshots/$number/snapshot/boot
    kernel=$(find "$boot" -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' 2>/dev/null | sort -V | tail -n 1)
    [ -n "$kernel" ] || continue
    version=${kernel#vmlinuz-}
    [ -e "$boot/initrd.img-$version" ] || continue
    path=/@snapshots/$number/snapshot
    echo "  menuentry 'Lumo $date' {"
    echo "    insmod btrfs"
    echo "    search --no-floppy --fs-uuid --set=root $uuid"
    echo "    linux $path/boot/$kernel root=UUID=$uuid ro rootflags=subvol=@snapshots/$number/snapshot lumo.snapshot=$number ${GRUB_CMDLINE_LINUX:-} ${GRUB_CMDLINE_LINUX_DEFAULT:-}"
    echo "    initrd $path/boot/initrd.img-$version"
    echo "  }"
  done
  echo "}"
}

menu() {
  [ -e "$config" ] || exit 0
  [ -z "$(booted)" ] || exit 0
  update-grub >/dev/null 2>&1
}

restore() {
  number=${1:-}
  case "$number" in
    ''|*[!0-9]*) echo "usage: lumo-snapshots restore NUMBER" >&2; exit 2 ;;
  esac
  device=$(findmnt -n -o SOURCE /.snapshots | sed 's/\[.*//')
  top=$(mktemp -d)
  trap 'umount "$top" 2>/dev/null || true; rmdir "$top"' EXIT
  mount -o subvolid=5 "$device" "$top"
  [ -d "$top/@snapshots/$number/snapshot" ] || { echo "no restore point $number" >&2; exit 1; }
  for old in "$top"/@.previous-*; do
    [ -d "$old" ] && btrfs subvolume delete "$old" >/dev/null
  done
  previous="$top/@.previous-$(date +%Y%m%d-%H%M%S)"
  mv "$top/@" "$previous"
  if ! btrfs subvolume snapshot "$top/@snapshots/$number/snapshot" "$top/@" >/dev/null; then
    mv "$previous" "$top/@"
    exit 1
  fi
  mkdir -p "$top/@$(dirname "$marker")"
  : > "$top/@$marker"
}

case "${1:-}" in
  setup) setup ;;
  status) status ;;
  grub) grub_entries ;;
  menu) menu ;;
  restore) restore "${2:-}" ;;
  *) echo "usage: lumo-snapshots setup|status|grub|menu|restore NUMBER" >&2; exit 2 ;;
esac
