[Desktop Entry]
Type=Application
Name=Install Lumo
Name[ru]=Установить Lumo
Name[nl]=Lumo installeren
GenericName=Install on disk
GenericName[ru]=Установка на диск
GenericName[nl]=Op schijf installeren
