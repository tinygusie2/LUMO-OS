#!/bin/sh
set -e

if [ "$1" = configure ]; then
    update-alternatives --install /usr/share/icons/default/index.theme x-cursor-theme \
        /usr/share/icons/kernora_cursors/cursor.theme 100
    if dpkg --compare-versions "$2" lt 1.4.28         && [ -e /usr/lib/systemd/system/NetworkManager-wait-online.service ]; then
        systemctl disable NetworkManager-wait-online.service >/dev/null 2>&1 || true
    fi
    esp=/boot/efi/EFI
    if [ -f "$esp/kernora/shimx64.efi" ] && [ -f "$esp/boot/bootx64.efi" ]         && cmp -s "$esp/boot/bootx64.efi" "$esp/kernora/grubx64.efi"; then
        echo "grub-efi-amd64 grub2/force_efi_extra_removable boolean true" | debconf-set-selections || true
        cp "$esp/kernora/grubx64.efi" "$esp/kernora/mmx64.efi" "$esp/boot/"             && cp "$esp/kernora/shimx64.efi" "$esp/boot/bootx64.efi" || true
    fi
    if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
        update-grub || true
    fi
fi

#DEBHELPER#
