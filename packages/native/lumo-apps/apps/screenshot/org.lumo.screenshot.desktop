[Desktop Entry]
Type=Application
Name=Screenshot
Name[ru]=Снимок экрана
Name[nl]=Schermafbeelding
GenericName=Screen capture
GenericName[ru]=Снимок экрана
GenericName[nl]=Schermafbeelding
Icon=org.lumo.screenshot
Exec=/usr/bin/lumo-screenshot
Categories=Qt;Utility;Graphics;
Keywords=screenshot;capture;print;снимок;скриншот;экран;
StartupNotify=false
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
X-KDE-Shortcuts=Print,Meta+Shift+S
