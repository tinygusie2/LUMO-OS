[Global]
IconName=org.lumo.focus
Name=Focus
Name[nl]=Focus
Name[ru]=Фокус
Comment=Lumo Focus
Comment[nl]=Lumo Focus
Comment[ru]=Фокус Lumo
DesktopEntry=org.lumo.focus

[Event/breakStarted]
Name=Break
Name[nl]=Pauze
Name[ru]=Перерыв
Comment=A focus round is over and a break begins
Comment[nl]=Een focusronde is voorbij en de pauze begint
Comment[ru]=Раунд фокусировки закончился, начинается перерыв
Action=Popup
Urgency=High

[Event/focusStarted]
Name=Back to focus
Name[nl]=Weer focussen
Name[ru]=Снова фокус
Comment=A break is over and the next focus round begins
Comment[nl]=De pauze is voorbij en de volgende focusronde begint
Comment[ru]=Перерыв закончился, начинается следующий раунд
Action=Popup
Urgency=High

[Event/finished]
Name=Focus finished
Name[nl]=Focus klaar
Name[ru]=Фокусировка завершена
Comment=Every focus round is done and all apps are allowed again
Comment[nl]=Alle focusrondes zijn klaar en alle apps mogen weer
Comment[ru]=Все раунды завершены, все приложения снова доступны
Action=Popup
Urgency=High
