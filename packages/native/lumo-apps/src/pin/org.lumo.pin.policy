<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Lumo</vendor>
  <action id="org.lumo.pin.manage">
    <description>Set up or remove your PIN</description>
    <description xml:lang="nl">Je pincode instellen of verwijderen</description>
    <description xml:lang="ru">Настроить или удалить PIN-код</description>
    <message>Enter your password to change your PIN</message>
    <message xml:lang="nl">Voer je wachtwoord in om je pincode te wijzigen</message>
    <message xml:lang="ru">Введите пароль, чтобы изменить PIN-код</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/lumo-pin</annotate>
  </action>
</policyconfig>
